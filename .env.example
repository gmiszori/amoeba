# Copy to .env and adjust. .env is git-ignored.

# Seconds a player has for each move before losing on time.
TURN_SECONDS=30

# Host port Caddy listens on. Use HTTP_BIND=0.0.0.0 to reach it from other
# devices on your network (e.g. testing on a phone).
HTTP_BIND=127.0.0.1
HTTP_PORT=8080

# --- Cloudflare Tunnel (VPS) ---
# Uncomment to start the cloudflared container with `docker compose up`.
# COMPOSE_PROFILES=tunnel
# Token from Cloudflare Zero Trust → Networks → Tunnels → your tunnel.
# Point the tunnel's public hostname at http://web:8080
CLOUDFLARE_TUNNEL_TOKEN=

# Extra allowed WebSocket origins (comma-separated host patterns). Not needed
# when the site is served from the same host as the WebSocket, which is the default.
ALLOWED_ORIGINS=
