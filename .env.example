# Copy to .env and adjust. .env is git-ignored.

# The public domain the game is served on. Point its DNS A/AAAA record at the
# server and keep ports 80 and 443 open: Caddy gets a Let's Encrypt
# certificate for it automatically.
# For local testing use "localhost" (self-signed HTTPS) or "http://localhost".
DOMAIN=amoeba.example.com

# Seconds a player has for each move before losing on time.
TURN_SECONDS=30

# Extra allowed WebSocket origins (comma-separated host patterns). Not needed
# when the site is served from the same host as the WebSocket, which is the default.
ALLOWED_ORIGINS=

# --- Development stack only (docker-compose.dev.yml) ---
# Use HTTP_BIND=0.0.0.0 to reach it from other devices on your network.
HTTP_BIND=127.0.0.1
HTTP_PORT=8080
