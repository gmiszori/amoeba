{
	admin off
	# Caddy runs unprivileged and can't add its local CA to the system trust
	# store; only relevant for DOMAIN=localhost.
	skip_install_trust
	# No access log. Caddy's own messages (errors, warnings) can include the
	# request that caused them; leave out everything about the player.
	log {
		format filter {
			wrap json
			fields {
				request>headers delete
				request>remote_ip delete
				request>client_ip delete
			}
		}
	}
	servers {
		# Only the webserver proxy reaches this Caddy. It passes TLS through
		# and prepends a PROXY header with the peer's address, trusted from
		# the proxy's fixed address alone.
		listener_wrappers {
			proxy_protocol {
				allow 172.31.250.2/32
			}
			tls
		}
		# The domain goes through Cloudflare's proxy, so that peer is a
		# Cloudflare server. From Cloudflare's addresses alone, the player's
		# address is taken from CF-Connecting-IP, so per-IP limits see real
		# players; a request from anywhere else can't set it. Ranges from
		# https://www.cloudflare.com/ips/ (checked 2026-10-31).
		trusted_proxies static 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
		client_ip_headers CF-Connecting-IP
		# The proxy forwards TCP only; don't advertise HTTP/3 over UDP.
		protocols h1 h2
	}
}

# Authenticated Origin Pulls. With ORIGIN_PULL=on in .env, the TLS handshake only
# succeeds when the client presents the certificate that Cloudflare sends for this
# zone, issued by our own CA in origin-pull-ca.pem. Other Cloudflare customers share
# Cloudflare's addresses, so the firewall alone can't tell them apart; this can.
# Off by default, for local development without Cloudflare in front. Setup and
# rollback: docs/authenticated-origin-pulls.md in github.com/gmiszori/webserver-proxy.
(origin_pull_on) {
	tls {
		client_auth {
			mode require_and_verify
			trust_pool file /etc/caddy/origin-pull-ca.pem
		}
	}
}
(origin_pull_off) {
}

# DOMAIN comes from .env. For a real domain Caddy gets and renews a Let's
# Encrypt certificate automatically and redirects HTTP to HTTPS. "localhost"
# gets a self-signed certificate; "http://localhost" serves plain HTTP.
{$DOMAIN:localhost} {
	encode zstd gzip
	import origin_pull_{$ORIGIN_PULL:off}

	header {
		# Only our own scripts, styles and WebSocket; no framing by other sites.
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src 'self' wss://{http.request.hostport}; object-src 'none'; base-uri 'none'; form-action 'self'; frame-ancestors 'none'"
		# Browsers ignore this over plain HTTP, so it's harmless locally.
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy no-referrer
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
		Cross-Origin-Opener-Policy same-origin
		-Server
	}

	# The security contact (RFC 9116); the policy itself is on miszori.dev.
	handle /.well-known/security.txt {
		header Content-Type "text/plain; charset=utf-8"
		respond <<TXT
			Contact: mailto:gergo@miszori.dev
			Expires: 2027-11-01T00:00:00.000Z
			Preferred-Languages: en, de, hu
			Policy: https://miszori.dev/security/
			Canonical: https://{$DOMAIN}/.well-known/security.txt
			TXT 200
	}

	handle /ws {
		reverse_proxy server:8080 {
			# Only the player's address. Caddy would otherwise keep the
			# X-Forwarded-For that Cloudflare passes on, whose first entry
			# the player can choose.
			header_up X-Forwarded-For {client_ip}
		}
	}

	handle {
		root * /srv
		# Room links (/r/<code>) are the same page; the app reads the code from
		# the path.
		@invite path_regexp ^/r/[a-zA-Z0-9]+/?$
		rewrite @invite /index.html
		# index.html uses templates for its own absolute URL in link previews.
		templates
		header /assets/* Cache-Control "public, max-age=31536000, immutable"
		# The page and the service worker must be checked on every visit so a
		# new deploy is picked up.
		@fresh path / /r/* /index.html /sw.js /manifest.webmanifest
		header @fresh Cache-Control "no-cache"
		file_server
	}
}

# The HTTP->HTTPS redirect, spelled out: Caddy's automatic redirect server
# doesn't get the PROXY-protocol listener above and would reject every request.
http:// {
	redir https://{host}{uri} 308
}
