{
	admin off
	# Caddy runs unprivileged and can't add its local CA to the system trust
	# store; only relevant for DOMAIN=localhost.
	skip_install_trust
	servers {
		# Only the webserver proxy reaches this Caddy. It passes TLS through
		# and prepends a PROXY header with the player's address, trusted from
		# the proxy's fixed address alone, so per-IP limits see real players.
		listener_wrappers {
			proxy_protocol {
				allow 172.31.250.2/32
			}
			tls
		}
		# The proxy forwards TCP only; don't advertise HTTP/3 over UDP.
		protocols h1 h2
	}
}

# DOMAIN comes from .env. For a real domain Caddy gets and renews a Let's
# Encrypt certificate automatically and redirects HTTP to HTTPS. "localhost"
# gets a self-signed certificate; "http://localhost" serves plain HTTP.
{$DOMAIN:localhost} {
	encode zstd gzip

	header {
		# Only our own scripts, styles and WebSocket; no framing by other sites.
		Content-Security-Policy "default-src 'self'; script-src 'self'; style-src 'self'; img-src 'self' data:; connect-src 'self' ws://{http.request.hostport} wss://{http.request.hostport}; object-src 'none'; base-uri 'none'; form-action 'self'; frame-ancestors 'none'"
		# Browsers ignore this over plain HTTP, so it's harmless locally.
		Strict-Transport-Security "max-age=31536000"
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy no-referrer
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
		Cross-Origin-Opener-Policy same-origin
		-Server
	}

	handle /ws {
		reverse_proxy server:8080
	}

	handle {
		root * /srv
		# Challenge (/c/) and group game (/r/) links are the same page; the app
		# reads the code from the path.
		@invite path_regexp ^/[cr]/[a-zA-Z0-9]+/?$
		rewrite @invite /index.html
		# index.html uses templates for its own absolute URL in link previews.
		templates
		header /assets/* Cache-Control "public, max-age=31536000, immutable"
		# The page and the service worker must be checked on every visit so a
		# new deploy is picked up.
		@fresh path / /c/* /r/* /index.html /sw.js /manifest.webmanifest
		header @fresh Cache-Control "no-cache"
		file_server
	}
}

# The HTTP->HTTPS redirect, spelled out: Caddy's automatic redirect server
# doesn't get the PROXY-protocol listener above and would reject every request.
http:// {
	redir https://{host}{uri} 308
}
